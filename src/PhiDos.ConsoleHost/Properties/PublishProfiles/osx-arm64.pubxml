<Project>
  <!--
    发布成单个可执行文件，自带 .NET 运行时，目标电脑不需要另装 .NET。
    用法：dotnet publish src/PhiDos.ConsoleHost -p:PublishProfile=osx-arm64
    注意不能开启裁剪（PublishTrimmed）：磁盘上的 IL 程序可能用到 .NET 库里的任何东西。
  -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>osx-arm64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <!-- 不要调试符号文件（.pdb） -->
    <DebugType>none</DebugType>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <AllowedReferenceRelatedFileExtensions>.xml</AllowedReferenceRelatedFileExtensions>
    <PublishDir>$(MSBuildThisFileDirectory)../../../../publish/osx-arm64/</PublishDir>
  </PropertyGroup>
</Project>
