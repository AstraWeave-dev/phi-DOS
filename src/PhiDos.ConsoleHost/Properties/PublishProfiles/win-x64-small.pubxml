<Project>
  <!--
    不带 .NET 运行时的小体积版（约 1MB），目标电脑需要装有 .NET 10 运行时。
    用法：dotnet publish src/PhiDos.ConsoleHost -p:PublishProfile=win-x64-small
    注意不能开启裁剪（PublishTrimmed）：磁盘上的 IL 程序可能用到 .NET 库里的任何东西。
  -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <!-- 不要调试符号文件（.pdb） -->
    <DebugType>none</DebugType>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <AllowedReferenceRelatedFileExtensions>.xml</AllowedReferenceRelatedFileExtensions>
    <PublishDir>$(MSBuildThisFileDirectory)../../../../publish/win-x64-small/</PublishDir>
  </PropertyGroup>
</Project>
